{
 "schema": "multiecho-ui.design/0.1",
 "name": "spring-frame-masked",
 "description": "The masking example: a next-frame predictor of the rendered spring, observed through a masker that keeps the pixels varying steadily along a stiffness sweep (frozen on discovery).",
 "chain": {
  "id": "spring-to-frame-predictor",
  "handle_world": 0,
  "worlds": [
   {
    "type": "physical",
    "id": "spring-scene",
    "revision": "parameters-only-v1",
    "description": "A unit mass on a spring, released or pushed",
    "handle": {
     "id": "spring-stiffness",
     "semantics": "Stiffness of the spring holding the mass",
     "axes": [
      {
       "name": "stiffness",
       "unit": "N/m",
       "lower": 1.0,
       "upper": 9.0
      }
     ]
    }
   },
   {
    "type": "plugin",
    "plugin": "examples.plugins.simulation:AnalyticOscillatorEngine",
    "params": {}
   },
   {
    "type": "plugin",
    "plugin": "examples.plugins.learned:TinyFramePredictor",
    "params": {
     "height": 16,
     "width": 32
    }
   }
  ],
  "interfaces": [
   {
    "type": "bridge",
    "id": "physical-to-sim",
    "channel": "parameters",
    "maps": [
     {
      "source": "stiffness",
      "target": "k"
     },
     {
      "source": "position",
      "target": "x0"
     },
     {
      "source": "velocity",
      "target": "v0"
     },
     {
      "source": "horizon",
      "target": "steps"
     }
    ],
    "constants": [
     {
      "key": "damping",
      "value": 0.3,
      "unit": "1/s"
     },
     {
      "key": "dt",
      "value": 0.25,
      "unit": "s"
     }
    ]
   },
   {
    "type": "scope",
    "id": "sim-to-model",
    "scope": {
     "id": "model-input",
     "channels": [
      "video"
     ]
    }
   }
  ],
  "analyst": {
   "id": "analyst",
   "scope": {
    "id": "frame",
    "channels": [
     "frame"
    ]
   },
   "masker": {
    "plugin": "multiecho_framework.masking:MonotonicSNRMask",
    "params": {},
    "width": 1
   }
  },
  "observation": {
   "id": "frame",
   "semantics": "Masked predicted next frame",
   "unit": "1"
  },
  "stimulus": {
   "frames": 16,
   "interval": 0.06666666666666667,
   "height": 16,
   "width": 32,
   "channel": "video",
   "observe_after": 1
  }
 },
 "design": {
  "experiment_id": "spring-frame-masked",
  "question": "Where in a predicted frame does the response to stiffness live?",
  "handle": "stiffness set in the physical scene",
  "observation_time": "the frame after the keyframe",
  "independence_unit": "one independently drawn initial condition",
  "reference": [
   4.0
  ],
